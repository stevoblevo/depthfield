{
  "id": "./",
  "name": "Hypermetapunk",
  "short_name": "Hypermetapunk",
  "description": "The third toolkit in the Storeybrook and Depthfield family: hyperreal dusk, chrome and neon, slapped with stickers, stamps, tape and marker.",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
  "background_color": "#0b0618",
  "theme_color": "#0b0618",
  "icons": [
    { "src": "site/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "site/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "site/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "The docs", "url": "./docs.html" },
    { "name": "Zine", "url": "./?theme=zine" }
  ]
}
